# Exemplo de configuração de ambiente (Não coloque senhas reais aqui!)
MONGODB_URI="mongodb+srv://<USUARIO>:<SENHA>@<SEU_CLUSTER>.mongodb.net/<NOME_DO_BANCO>?retryWrites=true&w=majority"

# Nova ETL (opt-in). Preencha apenas após aprovar os destinos.
MONGODB_DATABASE=
MONGODB_BRONZE_COLLECTION=
DATABASE_URL=
SILVER_SCHEMA=
SILVER_TABLE=
# Prefect local (opcional): PREFECT_API_URL=http://127.0.0.1:4200/api
